PORT=5000
DB_HOST=your-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name
# Set to true when using Aiven or another TLS-required MySQL provider.
DB_SSL=false
# Paste the provider CA certificate here when DB_SSL=true.
DB_SSL_CA=
JWT_SECRET=replace-with-a-secure-random-value
# Keep this key only on the backend. Never add it to VITE_ variables or frontend source.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: use the default unless you have a reason to change it.
OPENAI_MODEL=gpt-5.6-terra
